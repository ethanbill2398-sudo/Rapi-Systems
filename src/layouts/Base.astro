---
import '../styles/global.css';
import barlow700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Icon from '../components/Icon.astro';
import { getSettings } from '../lib/site';
import { graph, organization, localBusiness } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, ogImage, schema = [], noindex = false } = Astro.props;
const s = await getSettings();
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site).href;
const og = new URL(ogImage ?? s.defaultOgImage, site).href;
const jsonLd = graph(organization(s, site), localBusiness(s, site), ...schema);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={barlow700} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c4a3a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.brandName} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-ga={gaId}>
    <a href="#main" class="sr-only z-[70] bg-white px-4 py-3 font-semibold text-forest focus:not-sr-only focus:fixed focus:top-2 focus:left-2">Skip to content</a>
    <Header settings={s} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer settings={s} />

    <!-- Mobile sticky action bar -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[auto_1fr] gap-2 border-t border-white/10 bg-deep p-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] md:hidden">
      <a href={`tel:${s.phoneHref}`} class="btn btn-outline min-h-12 px-4 text-white" aria-label={`Call ${s.phone}`}>
        <Icon name="phone" class="size-5" /> Call
      </a>
      <a href="/contact" class="btn btn-primary" data-cta="mobile-bar">Request a Quote</a>
    </div>
    <div class="h-[calc(4.5rem+env(safe-area-inset-bottom,0px))] md:hidden" aria-hidden="true"></div>

    <ConsentBanner />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
