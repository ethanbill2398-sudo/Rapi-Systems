---
import Image from './Img.astro';
import type { ImageMetadata } from 'astro';
interface Props { heading: string; subheading?: string; image: { src: ImageMetadata; alt: string }; eyebrow?: string }
const { heading, subheading, image, eyebrow } = Astro.props;
// A phone-portrait photo stretched across a wide banner gets cropped to a blurry strip.
// On wider screens, show tall photos whole in a panel beside the heading instead.
const tall = image.src.width / image.src.height < 0.8;
---
<section class="on-dark relative isolate overflow-hidden bg-deep text-white">
  <Image
    src={image.src}
    alt={image.alt}
    widths={[480, 800, 1080, 1440, 1920]}
    sizes="100vw"
    quality={72}
    loading="eager"
    fetchpriority="high"
    class:list={['parallax absolute inset-0 -z-10 h-full w-full object-cover', tall && 'md:hidden']}
  />
  <div aria-hidden="true" class:list={['absolute inset-0 -z-10 bg-gradient-to-r from-deep/95 via-deep/75 to-deep/20', tall && 'md:hidden']}></div>
  <div class:list={['container-x py-20 md:py-28', tall && 'md:flex md:items-center md:justify-between md:gap-12 md:py-16']}>
    <div class="max-w-2xl">
      {eyebrow && <p class="mb-3 text-sm font-semibold tracking-[0.14em] text-field uppercase">{eyebrow}</p>}
      <h1 class="text-5xl md:text-6xl lg:text-7xl">{heading}</h1>
      <span class="bar"></span>
      {subheading && <p class="mt-5 max-w-xl text-lg text-white/90 md:text-xl">{subheading}</p>}
      <slot />
    </div>
    {tall && (
      <Image
        src={image.src}
        alt=""
        aria-hidden="true"
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 300px, 260px"
        quality={80}
        loading="eager"
        class="hidden h-[34rem] w-auto shrink-0 rounded-[4px] object-contain shadow-2xl md:block lg:h-[38rem]"
      />
    )}
  </div>
</section>
