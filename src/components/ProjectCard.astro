---
import Image from './Img.astro';
import type { CollectionEntry } from 'astro:content';
import { projectCategories } from '../content.config';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; headingLevel?: 'h2' | 'h3' }
const { project, headingLevel: H = 'h3' } = Astro.props;
const p = project.data;
const img = p.card ?? p.cover;
---
<article class="card-lift group relative flex flex-col overflow-hidden rounded-[4px] border border-line bg-white" data-category={p.category}>
  <div class="aspect-[4/3] overflow-hidden bg-mist">
    <Image src={img.src} alt={img.alt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-sm font-semibold text-forest">{projectCategories[p.category]}</p>
    <H class="mt-1 text-2xl">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">{p.title}</a>
    </H>
    <p class="mt-2 text-muted">{p.summary}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-4 font-semibold text-forest" aria-hidden="true">View project <Icon name="arrow-right" class="size-4 transition-transform duration-200 group-hover:translate-x-1" /></span>
  </div>
</article>
