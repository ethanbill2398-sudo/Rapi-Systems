---
import Icon from './Icon.astro';
import { getSettings } from '../lib/site';
interface Props { heading: string; text: string; id?: string }
const { heading, text, id = 'cta' } = Astro.props;
const s = await getSettings();
---
<section class="on-dark relative overflow-hidden bg-forest text-white" aria-labelledby={`${id}-h`}>
  <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-1/3 bg-deep md:block" style="clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%)"></div>
  <div aria-hidden="true" class="absolute inset-y-0 right-[calc(33.333%-0.5rem)] hidden w-2 bg-field md:block" style="transform: skewX(-12deg)"></div>
  <div class="container-x reveal relative grid gap-8 py-16 md:grid-cols-[1.4fr_1fr] md:items-center md:py-20">
    <div>
      <h2 id={`${id}-h`} class="text-4xl md:text-5xl">{heading}</h2>
      <span class="bar"></span>
      <p class="mt-5 max-w-xl text-lg text-white/90">{text}</p>
    </div>
    <div class="flex flex-col items-start gap-4 md:items-end">
      <a href="/contact" class="btn btn-primary" data-cta={`${id}-band`}>Request a Quote <Icon name="arrow-right" class="size-5" /></a>
      <a href={`tel:${s.phoneHref}`} class="inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-field decoration-2 underline-offset-4">
        <Icon name="phone" class="size-5" /> or call {s.phone}
      </a>
    </div>
  </div>
</section>
