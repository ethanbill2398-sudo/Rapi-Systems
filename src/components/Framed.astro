---
// An image in a fixed-ratio frame. Photos close to the frame's shape fill it (object-cover).
// Photos much taller than the frame are shown whole and centred over a soft blurred copy,
// so a phone-portrait shot is never cropped down to a zoomed-in strip.
import Image from './Img.astro';
import type { ImageMetadata } from 'astro';
interface Props {
  image: { src: ImageMetadata; alt: string };
  aspect: number; // frame width / height
  widths: number[];
  sizes: string;
  class?: string; // frame classes (set the aspect-ratio here)
  imgClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
}
const { image, aspect, widths, sizes, class: frameClass, imgClass, loading, fetchpriority } = Astro.props;
const tall = image.src.width / image.src.height < aspect * 0.75;
---
<div class:list={['relative overflow-hidden', frameClass]}>
  {tall && (
    <Image src={image.src} alt="" aria-hidden="true" widths={[96]} sizes="96px" quality={40} loading="lazy" class="absolute inset-0 h-full w-full scale-125 object-cover opacity-80 blur-2xl" />
  )}
  <Image
    src={image.src}
    alt={image.alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    class:list={['absolute inset-0 h-full w-full', tall ? 'object-contain' : 'object-cover', imgClass]}
  />
</div>
