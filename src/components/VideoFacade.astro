---
// Click-to-load Vimeo. No Vimeo script or iframe until the visitor presses play.
import Image from './Img.astro';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { vimeoEmbed } from '../lib/site';
interface Props {
  video: { title: string; vimeoId: string; hash?: string; aspect: string; poster: { src: ImageMetadata; alt: string } };
  class?: string;
}
const { video, class: className = '' } = Astro.props;
const src = vimeoEmbed(video.vimeoId, video.hash);
const portrait = video.aspect === '9/16';
---
<div
  class:list={['group relative overflow-hidden rounded-[4px] bg-deep', portrait ? 'mx-auto w-full max-w-[380px]' : 'w-full', className]}
  style={`aspect-ratio: ${video.aspect}`}
  data-video={src}
  data-video-title={video.title}
>
  <Image src={video.poster.src} alt="" widths={portrait ? [380, 760] : [640, 960, 1280]} sizes={portrait ? '380px' : '(min-width: 1024px) 60vw, 100vw'} class="absolute inset-0 h-full w-full object-cover" />
  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-deep/70 via-deep/10 to-transparent"></div>
  <button type="button" class="absolute inset-0 grid place-items-center" data-video-play>
    <span class="grid size-20 place-items-center rounded-full bg-field text-deep shadow-lg transition-transform duration-200 ease-out group-hover:scale-105 group-active:scale-95">
      <Icon name="play" class="ml-1 size-9" />
    </span>
    <span class="sr-only">Play video: {video.title}</span>
  </button>
  <p class="pointer-events-none absolute inset-x-0 bottom-0 p-4 font-display text-xl font-bold text-white uppercase">{video.title}</p>
</div>
