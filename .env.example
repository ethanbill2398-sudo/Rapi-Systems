# Canonical site origin, no trailing slash (used for canonical URLs, sitemap, Open Graph)
SITE_URL=

# Google reCAPTCHA v3
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=

# Vercel Blob (quote form file uploads, created automatically when you add a Blob store)
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 (loads only after cookie consent)
PUBLIC_GA_MEASUREMENT_ID=

# Decap CMS GitHub OAuth app
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
